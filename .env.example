# ─────────────────────────────────────────────────────────────
# Copy to .env.local (dev) and .env.test.local (tests). Never commit real values.
# None of these use the NEXT_PUBLIC_ prefix → they are never sent to the browser.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (development / production)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/arayeshgahman_dev

# Better Auth — generate a secret with: npx auth secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Phone OTP authentication — see docs/auth.md
#   static : fixed code AUTH_STATIC_OTP, NO SMS is sent (development/testing only)
#   sms    : random code via an SMS provider (no provider implemented yet)
AUTH_OTP_MODE=static
AUTH_STATIC_OTP=1111
# Production + static is refused unless BOTH are set (private test deployments only):
# AUTH_STATIC_OTP_ALLOW_IN_PRODUCTION=1
# AUTH_STATIC_OTP_ALLOWED_IPS=10.8.0.2,203.0.113.7   # matched against X-Real-IP set by nginx
# Future SMS mode:
# SMS_PROVIDER=

# File uploads — production: /var/lib/arayeshgahman/uploads (outside the web root)
UPLOAD_DIR=./.data/uploads
UPLOAD_MAX_BYTES=5242880

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Tests: put this in .env.test.local (Next.js does not load .env.local when NODE_ENV=test).
#    The database name MUST end with _test; tests drop and recreate its schema.
# DATABASE_URL_TEST=postgres://USER:PASSWORD@localhost:5432/arayeshgahman_test
